# AXIOM Development Environment Variables
# Copy this file to .env and fill in the values before running docker compose up.
#
# REQUIRED — these have no defaults and docker-compose will refuse to start without them:

# PostgreSQL
POSTGRES_PASSWORD=axiom_dev_password
POSTGRES_USER=axiom
POSTGRES_DB=axiom

# Neo4j
NEO4J_PASSWORD=axiom_dev_password

# JWT Secret (CHANGE THIS for any non-local deployment)
JWT_SECRET=dev-secret-change-in-production

# AI API Keys (at least one required for generation)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# OPTIONAL — these have sensible defaults if omitted:

# Grafana admin password (required for docker-compose)
GRAFANA_ADMIN_PASSWORD=admin
